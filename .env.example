# PhishGuard Environment Configuration Template
# Copy this file to .env and insert your personal API keys.
# NEVER commit the actual .env file or API keys to version control.

# VirusTotal v3 API Key (Required for live threat intelligence, optional for local heuristics)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Flask Server Configuration
PORT=5000
FLASK_DEBUG=false
